PORT=8088
BIND_ADDRESS=0.0.0.0
# Enable both when using a trusted HTTPS reverse proxy.
COOKIE_SECURE=0
TRUST_PROXY=0
# Optional: public HTTPS origin, without trailing path.
PUBLIC_URL=
# Image storage root: default volume, or an absolute host path (images go in media/).
MEDIA_STORAGE=gallery-data
# Published image channel, or sha-<full commit> to pin a release.
IMAGE_TAG=latest

# Container limits: leave resources for the LXC OS and other services.
WEB_CPUS=1.0
WEB_MEMORY_LIMIT=768m
